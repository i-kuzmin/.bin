#!/bin/sh
# Sort top-level Markdown list items by priority (P<n>), then urgency (U<n>).
# Labels live in {metadata}, e.g. {date: Sep 12, P2, U1}; keys without
# a value are labels. Lower numbers first; defaults are P2 and U2.
# Checkbox state comes first: [ ] open (or none), [~] in progress, [x] closed.

LC_ALL=C awk '
function emit(   s,p,u,rest,meta,n,i,f,a) {
    if (!have) return

    p = 2
    u = 2
    s = 0
    if (head ~ /^[*+-][[:space:]]+\[~\]/ || head ~ /^[0-9]+[.)][[:space:]]+\[~\]/) s = 1
    else if (head ~ /^[*+-][[:space:]]+\[[xX]\]/ || head ~ /^[0-9]+[.)][[:space:]]+\[[xX]\]/) s = 2
    rest = head
    while (match(rest, /\{[^}]*\}/)) {
        meta = substr(rest, RSTART + 1, RLENGTH - 2)
        rest = substr(rest, RSTART + RLENGTH)
        n = split(meta, a, ",")
        for (i = 1; i <= n; i++) {
            f = a[i]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", f)
            # A key without ":" is a label field.
            if (index(f, ":")) continue
            if (f ~ /^P[0-9]+$/) p = substr(f, 2) + 0
            else if (f ~ /^U[0-9]+$/) u = substr(f, 2) + 0
        }
    }

    # Record separator 034 preserves a whole item as one sort line.
    printf "%09d %09d %09d %09d %s\n", s, p, u, ++seq, block
}

/^[*+-][[:space:]]/ || /^[0-9][0-9]*[.)][[:space:]]/ {
    emit()
    head = $0
    block = $0
    have = 1
    next
}

{ if (have) block = block sprintf("%c", 28) $0 }

END { emit() }
' | sort -n -k1,1 -k2,2 -k3,3 -k4,4 \
  | sed 's/^[0-9]* [0-9]* [0-9]* [0-9]* //' \
  | tr '\034' '\n'
